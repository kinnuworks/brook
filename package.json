{
  "name": "oneaquahealth-hackathon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint",
    "data": "node scripts/fetch-oah-snapshot.mjs && node scripts/build-site-summaries.mjs",
    "fhir:definitions": "npx --yes tsx scripts/fhir-definitions.mjs",
    "fhir:samples": "npx --yes tsx scripts/fhir-samples.mjs",
    "fhir:validate": "node scripts/fhir-validate.mjs",
    "fhir:sandbox": "npx --yes tsx scripts/fhir-sandbox-roundtrip.mjs",
    "e2e": "node scripts/e2e-walkthrough.mjs",
    "a11y": "node scripts/a11y.mjs",
    "offline": "node scripts/offline-test.mjs",
    "eval:vision": "node scripts/eval-vision.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.6",
    "i18next": "^26.4.2",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "motion": "^13.5.0",
    "openai": "^7.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-map-gl": "^8.1.3",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/fhir": "^0.0.44",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vercel/node": "^17.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
